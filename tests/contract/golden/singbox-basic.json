      "auth": "SHA1",
      "auth_retry": "nointeract",
      "on_demand": true,
      "ping_interval": "10s",
      "ping_restart": "60s",
      "system": false,
      "redirect_gateway": true
    }
  ],
  "options": {
    "mixed_listen": "127.0.0.1",
