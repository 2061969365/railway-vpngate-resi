{
  "name": "singbox-basic",
  "kind": "config",
  "endpoints": [
    {
      "type": "openvpn-client",
      "tag": "vpngate-0",
      "server": "203.0.113.1",
      "server_port": 443,
      "network": "tcp",
      "username": "vpn",
      "password": "vpn",
      "tls": {
        "certificate": "-----BEGIN CERTIFICATE-----\nQ0E=\n-----END CERTIFICATE-----",
